{
  "name": "@hazard-globe/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GDACS caching proxy, area-watch subscriptions and web push alerts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "vapid": "web-push generate-vapid-keys",
    "test": "vitest run",
    "test:watch": "vitest",
    "store:import": "tsx src/store/import-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@turf/boolean-intersects": "^7.1.0",
    "@turf/circle": "^7.1.0",
    "@turf/helpers": "^7.1.0",
    "hono": "^4.6.0",
    "nodemailer": "^10.1.4",
    "pg": "^8.23.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
