# Generate with: npm run vapid --workspace server
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact GDACS/push services can reach if something goes wrong
VAPID_SUBJECT=mailto:maintainer@example.com

PORT=8787
# How often to poll GDACS, in minutes. Please keep this >= 10: GDACS is a free public service.
POLL_INTERVAL_MINUTES=15
# Days of history to request on each poll
LOOKBACK_DAYS=10
# Where subscriptions are stored: a JSON file, fine for a few hundred subscribers...
DATA_FILE=./data/store.json
# ...or Postgres, used instead of DATA_FILE when set. Tables are created and migrated on startup.
# Move existing subscriptions across with: npm run store:import --workspace server
# DATABASE_URL=postgres://hazard:hazard@localhost:5432/hazard_globe
# Origin of the web app, for CORS
WEB_ORIGIN=http://localhost:5173
# Where people open the app; confirm and unsubscribe links in emails start here. Defaults to WEB_ORIGIN.
# PUBLIC_URL=https://hazards.example.org

# Email alerts (optional): any SMTP server or provider. Addresses must be confirmed before alerts are sent.
# SMTP_URL=smtps://user:password@smtp.example.org:465
# MAIL_FROM="Hazard Globe <alerts@example.org>"

# Telegram alerts (optional): create a bot with @BotFather and paste its token. Run only ONE server
# instance with this set: Telegram lets one process at a time receive a bot's messages.
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Number of reverse proxies in front of the server (e.g. 1 behind nginx or a PaaS router), so rate limits
# see real client IPs. Leave at 0 when clients connect directly, or anyone could fake their IP.
TRUST_PROXY=0
# New subscriptions are refused beyond this many (existing ones can still update)
MAX_SUBSCRIBERS=1000

# Live flights from OpenSky Network. Works without credentials, but anonymous access only allows
# a refresh every 15 minutes. A free account (https://opensky-network.org > Account > API client)
# allows one every 2 minutes.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Seconds between OpenSky fetches; clamped to 900 anonymous / 90 with credentials
# FLIGHTS_REFRESH_SECONDS=120
